{
  "name": "transliterate-any-to-any-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && rimraf dist && vite build",
    "preview": "vite preview",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "tsc --noEmit && vite build --config vite.mobile.config.ts && cap sync",
    "android": "cap run android",
    "ios": "cap run ios",
    "icons:mobile": "node mobile/resources/render.mjs && capacitor-assets generate --ios --android --assetPath mobile/resources --iconBackgroundColor \"#D9AE4F\" --iconBackgroundColorDark \"#D9AE4F\" --splashBackgroundColor \"#FFFFFF\" --splashBackgroundColorDark \"#1A1822\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-speech-recognition": "^8.4.4",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "transliterate-any-to-any": "file:.."
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxc-transform-react": "^0.145.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "@capacitor/assets": {
      "sharp": "^0.35.5"
    }
  }
}
