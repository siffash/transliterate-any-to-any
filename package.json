{
  "name": "transliterate-any-to-any",
  "version": "0.0.1",
  "description": "Transliterate from any script to any script",
  "keywords": [
    "transliteration",
    "transliterate",
    "transcription",
    "transcribe",
    "internationalization",
    "internationalize",
    "latinization",
    "latinize",
    "romanization",
    "romanize",
    "cyrillization",
    "cyrillize",
    "t13n",
    "i18n",
    "International Components for Unicode",
    "ICU"
  ],
  "homepage": "https://github.com/siffash/transliterate-any-to-any#readme",
  "bugs": {
    "url": "https://github.com/siffash/transliterate-any-to-any/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siffash/transliterate-any-to-any.git"
  },
  "license": "Apache-2.0",
  "author": "Anton Sivashtenko",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --include ./src src/index.ts",
    "prebuild": "node ./src/helpers/patch-zlib.js",
    "build": "rimraf dist && tsdown",
    "type-check": "tsc --noEmit --pretty",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint --fix src",
    "format": "prettier --write src --config ./.prettierrc",
    "format:check": "prettier --check src --config ./.prettierrc",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "aromanize": "^0.1.5",
    "browser-or-node": "^3.0.0",
    "fflate": "^0.8.3",
    "hangul-js": "^0.2.6",
    "hanviet-pinyin-words": "^2.1.7",
    "intl-segmenter": "^1.0.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "opencc-js": "^1.4.0",
    "phonemize": "^2.0.0",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-node-polyfills": "^1.0.3",
    "@types/node": "^25.9.5",
    "@types/opencc-js": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "icu-transliterator": "^0.3.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.8",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tar": "7.5.13",
    "lodash": "^4.18.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "icu-transliterator@0.3.7": true
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
