{
  "name": "transliterate-any-to-any",
  "version": "0.0.1",
  "description": "Transliterate from any script to any script",
  "keywords": [
    "transliteration",
    "transliterate",
    "transcription",
    "transcribe",
    "internationalization",
    "internationalize",
    "latinization",
    "latinize",
    "romanization",
    "romanize",
    "cyrillization",
    "cyrillize",
    "t13n",
    "i18n",
    "International Components for Unicode",
    "ICU"
  ],
  "homepage": "https://github.com/siffash/transliterate-any-to-any#readme",
  "bugs": {
    "url": "https://github.com/siffash/transliterate-any-to-any/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siffash/transliterate-any-to-any.git"
  },
  "license": "Apache-2.0",
  "author": "Anton Sivashtenko",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "browser": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "browser": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsx watch --include ./src src/index.ts",
    "build": "tsdown src/index.ts --format cjs,esm --dts --target es2022 --platform neutral --shims --clean --minify",
    "type-check": "tsc --noEmit --pretty",
    "lint": "eslint src/**/*.ts --max-warnings=0",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts --config ./.prettierrc",
    "format:check": "prettier --check src/**/*.ts --config ./.prettierrc",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "aromanize": "^0.1.5",
    "hangul-js": "^0.2.6",
    "hanviet-pinyin-words": "^2.1.7",
    "icu-transliterator": "^0.3.7",
    "intl-segmenter": "^1.0.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "opencc-js": "^1.4.0",
    "phonemize": "^2.0.0",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^0.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/opencc-js": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.8",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "tar": "7.5.13",
    "lodash": "^4.18.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "icu-transliterator@0.3.7": true,
    "opencc@1.3.1": true
  }
}
